rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // ---------- Public catalog: read-only for everyone, write-only for admins ----------
    match /products/{productId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if resource.data.visible == true || isAdmin();
      allow write: if isAdmin();
    }

    match /pages/{pageId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true; // business/branding/SEO/delivery settings are public by nature
      allow write: if isAdmin();
    }

    // ---------- Reviews: public can create + read approved only ----------
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // ---------- Orders: private. Anyone can create (guest checkout via a
    // validated server route ideally, but rules double as defense-in-depth).
    // No client can ever list/read arbitrary orders — order lookup for
    // tracking goes through a server API route that checks phone + order
    // number server-side instead of relying on client-side Firestore reads. ----------
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow create: if true; // structure validated by Cloud Function / API route, not by rules alone
      allow update, delete: if isAdmin();
    }

    // ---------- Customers, coupons, admins: fully private ----------
    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    match /coupons/{couponId} {
      // Coupon validity is checked via a server route (spec #46), never
      // trusted from a raw client read of arbitrary coupon documents.
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if isAdmin();
    }

    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }
  }
}
