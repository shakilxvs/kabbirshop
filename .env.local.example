# Copy this file to .env.local for local dev, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# NEVER commit the real .env.local or the service-account JSON to git.

# --- Firebase client (public, safe to expose in the browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDuVGedM1WkCHbilZWH2Q4SOgkfH2IZL2g
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=kabbirshop.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=kabbirshop
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=kabbirshop.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=606697644177
NEXT_PUBLIC_FIREBASE_APP_ID=1:606697644177:web:cb54216d05dd2c302d1f30
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-TDBQWXQJ7T

# --- Firebase Admin SDK (server-only secret — used for admin auth checks,
# order-number transactions, and any privileged writes) ---
# These three values come from the service-account JSON you generate in
# Firebase Console → Project Settings → Service Accounts.
# Rotate the key you shared earlier and paste the NEW values here.
FIREBASE_ADMIN_PROJECT_ID=kabbirshop
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-fbsvc@kabbirshop.iam.gserviceaccount.com
# Keep the \n escapes literal (one line, quoted) when pasting into Vercel.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_NEW_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Optional analytics (leave blank to keep tracking fully disabled) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
